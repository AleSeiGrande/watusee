# Copiá este archivo a `.env` y completá los valores.
# NUNCA subas el `.env` real al repositorio.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5)
# ---------------------------------------------------------------------------
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# URL pública del sitio (sin barra final). Se usa para el sitemap, robots.txt
# y las etiquetas Open Graph. En producción: https://watusee.fun
# Si se deja vacío, se usa AUTH_URL o el dominio oficial como fallback.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# OAuth (opcional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (recuperar contraseña + formulario de contacto)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@watusee.fun"

# ---------------------------------------------------------------------------
# Pagos / planes  (página /pricing)
# ---------------------------------------------------------------------------
# Estrategia MVP: links de checkout hospedados. Generá un link por plan y
# período en tu proveedor (Stripe Payment Links, Paddle o Lemon Squeezy) y
# pegá la URL acá. Si quedan vacíos, la web muestra "próximamente" y lleva
# al formulario de contacto. Cambiar de proveedor = cambiar estas URLs.
#
# ALTERNATIVA (recomendada): podés setear todos estos links desde el panel de
# admin en la web (/admin), sin tocar este archivo ni reiniciar el server. El
# valor guardado en /admin tiene prioridad sobre la variable de entorno.
#
# Plan Frida (Creador)
NEXT_PUBLIC_CHECKOUT_FRIDA_MONTHLY=""
NEXT_PUBLIC_CHECKOUT_FRIDA_YEARLY=""
# Plan Da Vinci (Estudio)
NEXT_PUBLIC_CHECKOUT_DAVINCI_MONTHLY=""
NEXT_PUBLIC_CHECKOUT_DAVINCI_YEARLY=""
# Plan Mecenas (donación voluntaria): PayPal.me, Buy Me a Coffee, Ko-fi, etc.
NEXT_PUBLIC_DONATE_URL=""

# ---------------------------------------------------------------------------
# Webhooks de pago  (activación automática del plan al pagar)
# ---------------------------------------------------------------------------
# Opcional pero recomendado. Sin esto, los links de checkout cobran igual, pero
# el plan NO se activa solo (podés activarlo a mano desde /admin).
#
# 1) Stripe: creá el endpoint  POST /api/webhooks/stripe  en el dashboard de
#    Stripe (Developers > Webhooks), escuchando:
#      - checkout.session.completed
#     - customer.subscription.updated
#     - customer.subscription.deleted
#    Y pegá el "Signing secret" (whsec_...) acá. La web agrega automáticamente
#    `client_reference_id` a los Payment Links para saber a quién activarle.
STRIPE_WEBHOOK_SECRET=""
#
# 2) Genérico (cualquier otro proveedor, o Zapier / Make): POST a
#    /api/webhooks/generic con la cabecera `x-webhook-secret`. Ver README para
#    el formato del body.
GENERIC_WEBHOOK_SECRET=""


# ---------------------------------------------------------------------------
# Print Shop / merchandising  (página /merch, planes Frida y Da Vinci)
# ---------------------------------------------------------------------------
# Pegá el link de pedido de tu socio de impresión (Printful, Gelato, Printify,
# Redbubble...). Un link por producto; si un producto queda vacío, se usa el
# link general de abajo. Si no hay ninguno, la web invita a escribirnos.
NEXT_PUBLIC_MERCH_TSHIRT_URL=""
NEXT_PUBLIC_MERCH_MUG_URL=""
NEXT_PUBLIC_MERCH_POSTER_URL=""
# Link genérico del socio de impresión (fallback de los anteriores).
NEXT_PUBLIC_MERCH_PARTNER_URL=""

# ---------------------------------------------------------------------------
# Analítica  (visitas + atribución de campañas)
# ---------------------------------------------------------------------------
# Completá SOLO el proveedor que uses. También se puede setear desde /admin,
# sin tocar este archivo (el valor del panel tiene prioridad).
# Los primeros toques UTM (utm_source, utm_campaign, ref…) se guardan solos y
# se asocian al usuario al registrarse.
#
# Google Analytics 4 (Measurement ID con formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=""
# Plausible (dominio, ej. watusee.fun)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Umami (URL del script + Website ID)
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
