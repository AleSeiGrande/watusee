# Copiá este archivo a `.env` y completá los valores.
# NUNCA subas el `.env` real al repositorio.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5)
# ---------------------------------------------------------------------------
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth (opcional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (recuperar contraseña + formulario de contacto)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@watusee.fun"

# ---------------------------------------------------------------------------
# Pagos / planes  (página /pricing)
# ---------------------------------------------------------------------------
# Estrategia MVP: links de checkout hospedados. Generá un link por plan y
# período en tu proveedor (Stripe Payment Links, Paddle o Lemon Squeezy) y
# pegá la URL acá. Si quedan vacíos, la web muestra "próximamente" y lleva
# al formulario de contacto. Cambiar de proveedor = cambiar estas URLs.
#
# ALTERNATIVA (recomendada): podés setear todos estos links desde el panel de
# admin en la web (/admin), sin tocar este archivo ni reiniciar el server. El
# valor guardado en /admin tiene prioridad sobre la variable de entorno.
#
# Plan Frida (Creador)
NEXT_PUBLIC_CHECKOUT_FRIDA_MONTHLY=""
NEXT_PUBLIC_CHECKOUT_FRIDA_YEARLY=""
# Plan Da Vinci (Estudio)
NEXT_PUBLIC_CHECKOUT_DAVINCI_MONTHLY=""
NEXT_PUBLIC_CHECKOUT_DAVINCI_YEARLY=""
# Plan Mecenas (donación voluntaria): PayPal.me, Buy Me a Coffee, Ko-fi, etc.
NEXT_PUBLIC_DONATE_URL=""

# ---------------------------------------------------------------------------
# Print Shop / merchandising  (página /merch, planes Frida y Da Vinci)
# ---------------------------------------------------------------------------
# Pegá el link de pedido de tu socio de impresión (Printful, Gelato, Printify,
# Redbubble...). Un link por producto; si un producto queda vacío, se usa el
# link general de abajo. Si no hay ninguno, la web invita a escribirnos.
NEXT_PUBLIC_MERCH_TSHIRT_URL=""
NEXT_PUBLIC_MERCH_MUG_URL=""
NEXT_PUBLIC_MERCH_POSTER_URL=""
# Link genérico del socio de impresión (fallback de los anteriores).
NEXT_PUBLIC_MERCH_PARTNER_URL=""
