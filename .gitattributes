# Normalize line endings: keep LF in the repo regardless of the OS.
* text=auto eol=lf

# Explicit text types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.prisma text eol=lf

# Windows-only helpers keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets (never touch line endings)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.pdf  binary
*.zip  binary
*.mp4  binary
*.mp3  binary
*.db   binary

# Keep diffs readable for lockfiles
package-lock.json  -diff linguist-generated
